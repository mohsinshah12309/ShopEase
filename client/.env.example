# Copy this file to .env and fill in real values for local development.
# On Vercel, set these same variables in Project Settings > Environment Variables.

# Base URL of the backend API (no trailing slash needed; include /api)
VITE_API_URL=https://your-backend.onrender.com/api

# Stripe publishable key (pk_...). Safe to expose to the browser.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here